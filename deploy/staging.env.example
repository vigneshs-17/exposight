# ==============================================================================
# Exposight Staging Environment Variables (deploy/staging.env.example)
#
# DESIGNATION & HOST ISOLATION REQUIREMENT:
# 1. "Staging" is an operational and deployment designation, NOT an application mode.
#    The application configuration (src/asm/config.py) strictly supports
#    ENVIRONMENT=development, test, or production.
#    To enforce full production validation guards (disabling Swagger docs, enforcing
#    non-test DB names, non-local DB hosts, real HTTPS Supabase endpoints, and uvicorn
#    reverse-proxy header restrictions), staging deployments must run with:
#    ENVIRONMENT=production
#
# 2. DEDICATED STAGING HOST REQUIRED:
#    Setting COMPOSE_PROJECT_NAME=exposight-staging isolates container names, volume
#    names, and network names, but does NOT prevent host-level and subnet collisions.
#    The fixed bridge subnet 10.89.0.0/24 and host ports 80/443 in compose.prod.yml
#    will conflict with any other stack on the same Docker host. Staging must be
#    deployed to a separate, dedicated virtual machine.
#
# Use placeholders only in this file. Never place real credentials or secrets here.
# ==============================================================================

# Compose Project Identity & Image Tagging
# Enforces isolated project namespace for staging containers, volumes, and networks.
COMPOSE_PROJECT_NAME=exposight-staging

# Base commit tag used by compose.staging.override.yml to tag built images.
# REQUIRED: Must match the intended checked-out commit SHA (e.g. via `git rev-parse HEAD`).
# PRE-BUILD IDENTITY NOTICE:
# An image tag alone does not prove which source was built if the working directory
# Furthermore, image configuration IDs (from `docker inspect`) are distinct from
# image manifest digests (@sha256:...). Ordinary version tags provide build traceability,
# but are neither image configuration IDs nor immutable manifest digests.
IMAGE_TAG=7c552b36928ae71a5d0052f1d600c4a68e3e2fab

# Application environment mode. Must be 'production' to enforce security guards.
ENVIRONMENT=production

# Public Staging FQDN (used by Caddy reverse proxy for ACME TLS termination).
# Must have a valid public DNS A record resolving to the staging VM public IP.
DOMAIN=staging.yourdomain.invalid

# Database Configuration (Containerized PostgreSQL credentials on staging VM)
# Superuser credentials used exclusively by deploy/postgres-init and backups.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STAGING_SUPERUSER_PASSWORD_HEX24
POSTGRES_DB=exposight_staging

# Least-Privilege Database Roles (created on fresh volume by deploy/postgres-init/10-roles.sh)
# Owner role: owns application tables; used exclusively by the migrate service (Alembic).
OWNER_DB_USER=exposight_owner
OWNER_DB_PASSWORD=CHANGE_ME_STAGING_OWNER_PASSWORD_HEX24
MIGRATION_DATABASE_URL=postgresql+psycopg://exposight_owner:CHANGE_ME_STAGING_OWNER_PASSWORD_HEX24@db:5432/exposight_staging

# App role: used by api and worker; owns nothing; INSERT/SELECT only on audit_events.
# NOTE: src/asm/config.py strictly rejects database names ending in "_test", and rejects
# localhost/loopback database hosts in production mode.
APP_DB_USER=exposight_app
APP_DB_PASSWORD=CHANGE_ME_STAGING_APP_PASSWORD_HEX24
DATABASE_URL=postgresql+psycopg://exposight_app:CHANGE_ME_STAGING_APP_PASSWORD_HEX24@db:5432/exposight_staging

# Supabase Authentication (Dedicated Staging Project)
# CRITICAL: Must be a completely separate Supabase project from production.
# Configure Site URL (https://<DOMAIN>) and Redirect URL (https://<DOMAIN>/app).
# Configure ECC (ES256) or RSA (RS256) JWT keys; HS256 is rejected by src/asm/auth/token.py.
SUPABASE_URL=https://your-staging-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_STAGING_SUPABASE_ANON_PUBLIC_KEY
JWT_AUDIENCE=authenticated

# Accounts allowed to create organizations (JSON list of emails).
# Unset or empty means invite-only demo mode; nobody can create organizations.
ORG_CREATION_ALLOWED_EMAILS=["staging-operator@example.com"]

# Public Resolvers for Domain Ownership DNS Verification (src/asm/verification.py)
# Must contain at least two distinct public IPv4 addresses. Host resolver is blocked.
VERIFICATION_RESOLVERS=["1.1.1.1", "9.9.9.9"]

# Optional Subdomain Discovery Fallback API Key (Cert Spotter)
# Can be left empty for staging verification.
CERTSPOTTER_API_KEY=

# Discovery Resource Limits (Phase E-1a / Discovery Limit Checkpoint)
# Ingestion response body limit (application-consumed response bytes, default 10 MiB)
DISCOVERY_MAX_RESPONSE_BYTES=10485760
# Hostname selection cap prior to DNS resolution (default 1,000)
# Prioritizes observed apex domain at index 0 (if present), followed by lexicographically sorted subdomains.
DISCOVERY_MAX_HOSTS=1000
# NOTE ON PRODUCTION CONFIGURABILITY GAP:
# compose.prod.yml does not forward DISCOVERY_MAX_RESPONSE_BYTES or DISCOVERY_MAX_HOSTS to the worker.
# compose.staging.override.yml forwards both for staging verification. Production is already bounded
# by hardcoded defaults in src/asm/discovery.py (10 MiB / 1,000 hosts); forwarding them in compose.prod.yml
# is tracked as separate production follow-up work.

# Staging SMTP Configuration
# Default baseline behavior: Leave SMTP_HOST empty ("") to disable outbound email.
# Source verification (src/asm/worker/worker.py:1553-1554): When SMTP_HOST is empty,
# deliver_pending_alerts() immediately returns 0 without claiming rows.
# Generated notifications remain safely in status='pending' in alert_notifications.
#
# DRAIN & BATCH PROCESSING WARNING:
# Setting SMTP_HOST will cause deliver_pending_alerts() to begin processing previously
# accumulated pending notifications in alert_notifications under standard batch and
# retry rules (batch limit of 20, rate quotas, next_attempt_at <= now()).
# Before enabling SMTP delivery, confirm all queued recipient addresses are controlled test mailboxes.
#
# CONTROLLED MAIL-SINK CONFIGURATION (--profile mailsink):
# Enabling the Compose profile `--profile mailsink` spins up the sink container but does
# NOT automatically reconfigure the worker. To direct worker deliveries to the sink:
#   SMTP_HOST=127.0.0.1
#   SMTP_PORT=1025
#   SMTP_STARTTLS=false
#   SMTP_SSL=false
#   SMTP_USERNAME=
#   SMTP_PASSWORD=
#   SMTP_FROM=alerts@staging.yourdomain.invalid
#   SMTP_TIMEOUT=10
# Egress note: The sink shares the worker egress network namespace on loopback (127.0.0.1:1025).
# Outbound email forwarding in Mailpit is disabled by default (no external SMTP relay configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=alerts@staging.yourdomain.invalid
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10

# Retention purge in worker (disabled by default)
RETENTION_PURGE_ENABLED=false
