# ==============================================================================
# Exposight Production Environment Variables (.env.production.example)
#
# Sourced from:
# - src/asm/config.py:20 (DATABASE_URL)
# - src/asm/config.py:31 (SUPABASE_PUBLISHABLE_KEY)
# - src/asm/auth/config.py:40 (SUPABASE_URL)
# - src/asm/auth/config.py:48 (JWT_AUDIENCE)
# - src/asm/discovery.py:382 (CERTSPOTTER_API_KEY)
# - src/asm/worker/worker.py:144-165 (SMTP_HOST, SMTP_PORT, SMTP_FROM, SMTP_USERNAME, SMTP_PASSWORD, SMTP_STARTTLS, SMTP_SSL)
# ==============================================================================

# Application environment mode (development | test | production). In production the api and
# worker refuse to start with a _test or localhost DATABASE_URL, placeholder values, or a
# non-https SUPABASE_URL, and /docs, /redoc and /openapi.json are disabled (src/asm/config.py).
ENVIRONMENT=production

# Public Domain (used by Caddy reverse proxy for automatic HTTPS)
DOMAIN=exposight.dev

# Database Configuration (PostgreSQL container credentials)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_RANDOM_PASSWORD
POSTGRES_DB=exposight

# Least-privilege roles (created on a fresh volume by deploy/postgres-init/10-roles.sh).
# POSTGRES_USER/POSTGRES_PASSWORD above are the superuser: used only for init and backups.
# Owner role: owns all tables and runs Alembic migrations (migrate service only).
OWNER_DB_USER=exposight_owner
OWNER_DB_PASSWORD=CHANGE_ME_OWNER_PASSWORD
MIGRATION_DATABASE_URL=postgresql+psycopg://exposight_owner:CHANGE_ME_OWNER_PASSWORD@db:5432/exposight
# App role: used by api and worker; owns nothing; INSERT/SELECT only on audit_events.
APP_DB_USER=exposight_app
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD
DATABASE_URL=postgresql+psycopg://exposight_app:CHANGE_ME_APP_PASSWORD@db:5432/exposight

# Supabase Authentication (Production Project)
# CRITICAL: Use the public anon/publishable key only. Never place service_role keys here.
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_SUPABASE_ANON_PUBLIC_KEY
JWT_AUDIENCE=authenticated

# Optional Subdomain Discovery Fallback API Key
# Free tier works without key within daily rate limits.
CERTSPOTTER_API_KEY=

# Production SMTP Email Delivery Configuration
# Leave SMTP_HOST empty to disable outgoing notification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=alerts@exposight.dev
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Implicit TLS (SMTPS, usually SMTP_PORT=465). Enable at most one of SMTP_STARTTLS and SMTP_SSL.
# SMTP_USERNAME/SMTP_PASSWORD are refused unless one of them is enabled.
SMTP_SSL=false
SMTP_TIMEOUT=10
